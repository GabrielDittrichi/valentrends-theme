{% schema %}
{
  "name": "Benefits Bar",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit",
      "settings": [
        {
          "type": "html",
          "id": "svg_icon",
          "label": "SVG Icon (Optional)",
          "info": "Paste SVG code here. If empty, a default icon is used."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "bold_text",
          "label": "Bold Text",
          "default": "On all orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Bar",
      "blocks": [
        {
          "type": "benefit_item",
          "settings": {
            "text": "Parcelamento",
            "bold_text": "Em até 6x sem juros"
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Frete grátis",
            "bold_text": "acima de R$900"
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Primeira troca",
            "bold_text": "Gratuita"
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "5% OFF",
            "bold_text": "no PIX"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .benefits-bar {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .benefits-bar__container {
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    gap: 20px;
  }
  .benefits-bar__item {
    display: flex;
    align-items: center;
    gap: 15px;
    flex: 1;
    min-width: 200px;
    justify-content: center;
  }
  .benefits-bar__icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .benefits-bar__icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .benefits-bar__text p {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }
  .benefits-bar__text strong {
    display: block;
    font-weight: bold;
    text-transform: uppercase;
  }
  
  @media (max-width: 768px) {
    .benefits-bar__container {
      flex-wrap: nowrap;
      overflow-x: hidden;
      justify-content: flex-start;
      scroll-behavior: smooth;
    }
    .benefits-bar__item {
      flex: 0 0 100%;
      justify-content: center;
    }
  }
</style>

<div class="benefits-bar">
  <div class="benefits-bar__container">
    {% for block in section.blocks %}
      <div class="benefits-bar__item" {{ block.shopify_attributes }}>
        <div class="benefits-bar__icon">
          {% if block.settings.svg_icon != blank %}
            {{ block.settings.svg_icon }}
          {% else %}
            <!-- Default Icon (Checkmark) -->
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {% endif %}
        </div>
        <div class="benefits-bar__text">
          <p>
            {{ block.settings.text }}
            {% if block.settings.bold_text != blank %}
              <strong>{{ block.settings.bold_text }}</strong>
            {% endif %}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const containers = document.querySelectorAll('.benefits-bar__container');
    
    containers.forEach(container => {
      if (!container) return;

      let currentIndex = 0;
      let interval;

      function startSlider() {
        // Only run on mobile
        if (window.innerWidth > 768) {
             container.scrollTo({ left: 0 });
             return;
        }

        if (interval) clearInterval(interval);

        interval = setInterval(() => {
          const items = container.querySelectorAll('.benefits-bar__item');
          if (items.length <= 1) return;

          currentIndex++;
          if (currentIndex >= items.length) {
            currentIndex = 0;
          }

          const scrollPos = currentIndex * container.clientWidth;
          container.scrollTo({
            left: scrollPos,
            behavior: 'smooth'
          });
        }, 3000); // 3 seconds per slide
      }

      // Initial check
      startSlider();

      // Handle resize
      window.addEventListener('resize', () => {
        clearInterval(interval);
        startSlider();
      });
    });
  });
</script>