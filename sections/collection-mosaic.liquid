{% schema %}
{
  "name": "Collection Mosaic",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 36
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 36
    }
  ],
  "blocks": [
    {
      "type": "mosaic_item",
      "name": "Mosaic Item",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color (if no image)",
            "default": "#8B4513"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Collection Name"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Subtitle",
            "default": "Shop Now >>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
            "type": "select",
            "id": "text_color",
            "label": "Text Color",
            "options": [
                { "value": "white", "label": "White" },
                { "value": "black", "label": "Black" }
            ],
            "default": "white"
        },
        {
            "type": "select",
            "id": "width",
            "label": "Block Width (Desktop)",
            "options": [
                { "value": "half", "label": "Half Width (1/2)" },
                { "value": "full", "label": "Full Width (1/1)" }
            ],
            "default": "half",
            "info": "First two blocks should be Half, third should be Full to match reference."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Mosaic",
      "blocks": [
        {
          "type": "mosaic_item",
          "settings": {
            "title": "GOLDEN BROWN",
            "subtitle": ">>",
            "width": "half"
          }
        },
        {
          "type": "mosaic_item",
          "settings": {
            "title": "SALE",
            "subtitle": "PEÇAS SELECIONADAS COM DESCONTO",
            "background_color": "#8B4513",
            "width": "half"
          }
        },
        {
          "type": "mosaic_item",
          "settings": {
            "title": "VESTIDOS",
            "subtitle": ">>",
            "width": "full"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .collection-mosaic-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .collection-mosaic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .mosaic-item {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-height: 300px; /* Minimum height */
    background-size: cover;
    background-position: center;
    transition: transform 0.3s ease;
  }

  .mosaic-item--full {
    grid-column: span 2;
    min-height: 400px;
  }

  .mosaic-item:hover .mosaic-item__bg {
    transform: scale(1.05);
  }

  .mosaic-item__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
    z-index: 0;
  }

  .mosaic-item__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 20px;
  }

  .mosaic-item__title {
    font-size: 32px;
    font-weight: 400; /* Thin/Elegant font */
    margin: 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .mosaic-item__title strong {
      font-weight: 700;
  }

  .mosaic-item__subtitle {
    font-size: 14px;
    margin-top: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Text Colors */
  .text-white .mosaic-item__title,
  .text-white .mosaic-item__subtitle {
    color: #ffffff;
  }

  .text-black .mosaic-item__title,
  .text-black .mosaic-item__subtitle {
    color: #000000;
  }

  @media (max-width: 768px) {
    .collection-mosaic-grid {
      grid-template-columns: 1fr;
    }
    .mosaic-item--full {
      grid-column: span 1;
    }
    .mosaic-item {
        min-height: 250px;
    }
  }
</style>

<div class="collection-mosaic-section">
  <div class="collection-mosaic-grid">
    {% for block in section.blocks %}
      {% assign width_class = '' %}
      {% if block.settings.width == 'full' %}
        {% assign width_class = 'mosaic-item--full' %}
      {% endif %}

      <a href="{{ block.settings.link | default: '#' }}" class="mosaic-item {{ width_class }} text-{{ block.settings.text_color }}" {{ block.shopify_attributes }} style="background-color: {{ block.settings.background_color }};">
        {% if block.settings.image != blank %}
            <div class="mosaic-item__bg" style="background-image: url({{ block.settings.image | image_url: width: 1200 }});"></div>
        {% endif %}
        
        <div class="mosaic-item__content">
          <h3 class="mosaic-item__title">{{ block.settings.title }}</h3>
          {% if block.settings.subtitle != blank %}
            <div class="mosaic-item__subtitle">{{ block.settings.subtitle }}</div>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>
