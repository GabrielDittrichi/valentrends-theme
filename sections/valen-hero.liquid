<section class="hero-editorial hero-{{ section.id }}"> 
   <div class="hero-editorial__viewport"> 
     <div class="hero-editorial__track"> 
 
       {% for block in section.blocks %} 
         {% if block.settings.collection != blank and block.settings.image_desktop != blank %} 
           <a 
             href="{{ block.settings.collection.url }}" 
             class="hero-editorial__slide" 
             {{ block.shopify_attributes }} 
           > 
             <img 
               class="hero-editorial__image hero-desktop" 
               src="{{ block.settings.image_desktop | image_url: width: 2400 }}" 
               alt="{{ block.settings.collection.title }}" 
               loading="lazy" 
             > 
 
             {% if block.settings.image_mobile != blank %} 
               <img 
                 class="hero-editorial__image hero-mobile" 
                 src="{{ block.settings.image_mobile | image_url: width: 1600 }}" 
                 alt="{{ block.settings.collection.title }}" 
                 loading="lazy" 
               > 
             {% endif %} 
           </a> 
         {% endif %} 
       {% endfor %} 
 
     </div> 
 
     <!-- DOTS SOBRE A IMAGEM --> 
     <div class="hero-editorial__dots"> 
       {% for block in section.blocks %} 
         <button 
           class="hero-dot{% if forloop.first %} is-active{% endif %}" 
           data-index="{{ forloop.index0 }}" 
           aria-label="Slide {{ forloop.index }}" 
         ></button> 
       {% endfor %} 
     </div> 
 
   </div> 
 </section> 
 
 <style> 
 /* =============================== 
    FIX GLOBAL 
 ================================ */ 
 html, body { 
   overflow-x: hidden; 
 } 
 
 /* =============================== 
    HERO BASE 
 ================================ */ 
 .hero-{{ section.id }} { 
   width: 100%; 
   background: #f7efe6; 
   overflow: hidden; 
 } 
 
 .hero-editorial__viewport { 
   width: 100%; 
   position: relative; 
   overflow: hidden; 
 } 
 
 .hero-editorial__track { 
   display: flex; 
   transition: transform 0.8s ease; 
 } 
 
 /* =============================== 
    SLIDE 
 ================================ */ 
 .hero-editorial__slide { 
   flex: 0 0 100%; 
   width: 100%; 
   position: relative; 
   display: block; 
   overflow: hidden; 
 } 
 
 /* ALTURA */ 
 @media (min-width: 750px) { 
   .hero-editorial__slide { 
     height: 78vh; 
   } 
 } 
 
 @media (max-width: 749px) { 
   .hero-editorial__slide { 
     height: 62vh; 
   } 
 } 
 
 /* IMAGENS */ 
 .hero-editorial__image { 
   position: absolute; 
   inset: 0; 
   width: 100%; 
   height: 100%; 
   object-fit: cover; 
 } 
 
 .hero-desktop { 
   display: block; 
 } 
 
 .hero-mobile { 
   display: none; 
 } 
 
 @media (max-width: 749px) { 
   .hero-desktop { 
     display: none; 
   } 
   .hero-mobile { 
     display: block; 
   } 
 } 
 
 /* =============================== 
    DOTS SOBRE IMAGEM 
 ================================ */ 
 .hero-editorial__dots { 
   position: absolute; 
   bottom: 18px; 
   left: 50%; 
   transform: translateX(-50%); 
   display: flex; 
   gap: 10px; 
   z-index: 5; 
   pointer-events: auto; 
 } 
 
 .hero-dot { 
   width: 8px; 
   height: 8px; 
   border-radius: 50%; 
   background: rgba(255,255,255,0.5); 
   border: none; 
   cursor: pointer; 
   padding: 0; 
 } 
 
 .hero-dot.is-active { 
   background: #ffffff; 
 } 
 </style> 
 
 <script> 
 (function () { 
   const section = document.querySelector('.hero-{{ section.id }}'); 
   if (!section) return; 
 
   const track = section.querySelector('.hero-editorial__track'); 
   const slides = section.querySelectorAll('.hero-editorial__slide'); 
   const dots = section.querySelectorAll('.hero-dot'); 
 
   if (!slides.length) return; 
 
   let index = 0; 
   let timer; 
 
   function goTo(i) { 
     index = i; 
     track.style.transform = `translateX(-${i * 100}%)`; 
 
     dots.forEach(d => d.classList.remove('is-active')); 
     if (dots[i]) dots[i].classList.add('is-active'); 
   } 
 
   function autoplay() { 
     timer = setInterval(() => { 
       goTo((index + 1) % slides.length); 
     }, 5000); 
   } 
 
   dots.forEach(dot => { 
     dot.addEventListener('click', (e) => { 
       e.preventDefault(); 
       e.stopPropagation(); 
       clearInterval(timer); 
       goTo(Number(dot.dataset.index)); 
       autoplay(); 
     }); 
   }); 
 
   goTo(0); 
   autoplay(); 
 })(); 
 </script> 
 
 {% schema %} 
 { 
   "name": "Hero Editorial", 
   "tag": "section", 
   "blocks": [ 
     { 
       "type": "slide", 
       "name": "Slide", 
       "settings": [ 
         { 
           "type": "collection", 
           "id": "collection", 
           "label": "Coleção" 
         }, 
         { 
           "type": "image_picker", 
           "id": "image_desktop", 
           "label": "Imagem Desktop" 
         }, 
         { 
           "type": "image_picker", 
           "id": "image_mobile", 
           "label": "Imagem Mobile" 
         } 
       ] 
     } 
   ], 
   "presets": [ 
     { 
       "name": "Hero Editorial", 
       "blocks": [ 
         { "type": "slide" }, 
         { "type": "slide" }, 
         { "type": "slide" } 
       ] 
     } 
   ] 
 } 
 {% endschema %}