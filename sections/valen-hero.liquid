{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Controle de Visibilidade Desktop/Mobile Incondicional */
  @media screen and (max-width: 749px) {
    .valen-hero-image--desktop { display: none !important; }
    .valen-hero-image--mobile { display: block !important; width: 100%; height: 100%; object-fit: cover; }
    
    /* Altura fixa para mobile */
    .valen-hero-media {
      height: 80vh !important;
      min-height: 500px;
    }
  }

  @media screen and (min-width: 750px) {
    .valen-hero-image--desktop { display: block !important; width: 100%; height: 100%; object-fit: cover; }
    .valen-hero-image--mobile { display: none !important; }
    
    /* Limite de altura para desktop para evitar imagens gigantes */
    .valen-hero-media {
      height: auto;
      max-height: 85vh; /* Limita a 85% da altura da tela */
      aspect-ratio: auto; /* Respeita proporção natural até o limite */
      overflow: hidden;
      position: relative;
    }
    
    /* Se a imagem for muito alta, forçar object-fit cover dentro do limite */
    .valen-hero-media img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  /* Estilos das Setas Customizadas (Valen Style) */
  .slideshow__controls {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 2;
  }

  .slideshow__controls .slider-button {
    pointer-events: auto;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #ffffff !important;
    border: 1px solid rgba(0,0,0,0.05) !important;
    border-radius: 8px !important;
    width: 48px !important;
    height: 48px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1) !important;
    transition: transform 0.2s ease, background 0.2s ease;
    z-index: 3;
  }

  .slideshow__controls .slider-button:hover {
    background: #f8f8f8 !important;
    transform: translateY(-50%) scale(1.05);
  }
  
  .slideshow__controls .slider-button--prev {
    left: 10px !important;
  }
  
  .slideshow__controls .slider-button--next {
    right: 10px !important;
  }

  .slideshow__controls .slider-button svg,
  .slideshow__controls .slider-button .svg-wrapper {
    color: #000000 !important;
    fill: #000000 !important;
    width: 18px !important;
    height: 18px !important;
  }
  
  /* Remove paginação e outros controles padrão */
  .slider-counter, .slideshow__autoplay { display: none !important; }

  /* Overlay de Texto */
  .valen-hero-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centraliza verticalmente por padrão */
    pointer-events: none;
    padding: 2rem;
  }
  
  .valen-hero-box {
    pointer-events: auto;
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
  }
  
  /* Alinhamentos Específicos */
  .content-left { align-items: flex-start; text-align: left; }
  .content-center { align-items: center; text-align: center; }
  .content-right { align-items: flex-end; text-align: right; }
  
  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .valen-hero-content {
       justify-content: flex-end; /* Texto embaixo no mobile */
       padding-bottom: 4rem;
    }
  }
{%- endstyle -%}

<slideshow-component
  class="slider-mobile-gutter section-{{ section.id }}-padding"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
  style="position: relative; display: block;"
>
  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls slider-buttons">
      <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </div>
  {%- endif -%}

  <div
    class="slideshow banner grid grid--1-col slider slider--everywhere"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <!-- Container de Mídia com Altura Controlada -->
        <div class="slideshow__media banner__media media valen-hero-media">
          {%- if block.settings.image -%}
            <!-- Imagem Desktop -->
            {{
              block.settings.image
              | image_url: width: 3840
              | image_tag:
                loading: 'lazy',
                width: block.settings.image.width,
                height: block.settings.image.height,
                class: 'valen-hero-image--desktop',
                sizes: '100vw',
                widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            }}
            
            <!-- Imagem Mobile (se definida, senão usa a desktop no mobile também mas com classes de mobile) -->
            {%- if block.settings.image_mobile != blank -%}
              {{
                block.settings.image_mobile
                | image_url: width: 750
                | image_tag:
                  loading: 'lazy',
                  width: block.settings.image_mobile.width,
                  height: block.settings.image_mobile.height,
                  class: 'valen-hero-image--mobile',
                  sizes: '100vw',
                  widths: '375, 550, 750'
              }}
            {%- else -%}
               <!-- Fallback: se não tiver imagem mobile, mostrar desktop no mobile também (via CSS teria que ajustar, mas ideal é ter imagem separada) -->
               <!-- Neste caso, duplicamos a tag para aplicar a classe mobile correta -->
               {{
                block.settings.image
                | image_url: width: 750
                | image_tag:
                  loading: 'lazy',
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  class: 'valen-hero-image--mobile',
                  sizes: '100vw',
                  widths: '375, 550, 750'
              }}
            {%- endif -%}
          {%- else -%}
             {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <!-- Conteúdo de Texto Overlay -->
        {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
          <div class="valen-hero-content content-{{ block.settings.text_alignment }}">
            <div class="valen-hero-box color-{{ block.settings.color_scheme }} gradient" style="background-color: transparent;">
              {%- if block.settings.heading != blank -%}
                <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div class="banner__text rte">
                  <p>{{ block.settings.subheading }}</p>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="banner__buttons">
                  <a href="{{ block.settings.link | default: '#' }}" class="button button--primary">
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</slideshow-component>

{% schema %}
{
  "name": "Valen Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.slideshow.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.content"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "t:sections.slideshow.settings.accessibility.label",
      "info": "t:sections.slideshow.settings.accessibility.info",
      "default": "t:sections.slideshow.settings.accessibility.default"
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem Desktop (Obrigatória)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem Mobile (Opcional)",
          "info": "Se não selecionada, usará a imagem desktop redimensionada."
        },
        {
          "type": "header",
          "content": "Texto e Botões"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Título",
          "default": "Valen Trends"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Pequeno" },
            { "value": "h1", "label": "Médio" },
            { "value": "h0", "label": "Grande" },
            { "value": "hxl", "label": "Extra Grande" }
          ],
          "default": "h1",
          "label": "Tamanho do Título"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "Subtítulo",
          "default": "Sua moda, seu estilo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do Botão",
          "default": "Comprar Agora"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do Botão"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alinhamento do Texto",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Direita" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Esquema de Cores",
          "options": [
            { "value": "accent-1", "label": "Destaque 1" },
            { "value": "accent-2", "label": "Destaque 2" },
            { "value": "background-1", "label": "Fundo 1" },
            { "value": "background-2", "label": "Fundo 2" },
            { "value": "inverse", "label": "Inverso" }
          ],
          "default": "inverse"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Opacidade da Sombra na Imagem",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valen Hero",
      "blocks": [
        {
          "type": "hero_slide"
        },
        {
          "type": "hero_slide"
        }
      ]
    }
  ]
}
{% endschema %}