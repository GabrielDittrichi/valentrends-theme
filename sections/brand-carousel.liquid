{% schema %}
{
  "name": "Brand Marquee",
  "settings": [
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Logo Width (Desktop)",
      "default": 150
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Logo Width (Mobile)",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos",
      "default": 50
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F3F3F3"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "sec",
      "label": "Animation Speed",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "brand_logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Marquee",
      "blocks": [
        { "type": "brand_logo" },
        { "type": "brand_logo" },
        { "type": "brand_logo" },
        { "type": "brand_logo" },
        { "type": "brand_logo" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .brand-marquee-section {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    width: 100vw; /* Força a seção a ir de ponta a ponta */
    margin-left: calc(-50vw + 50%); /* Corrige o posicionamento fora do page-width padrão */
    display: flex;
  }

  .brand-marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    padding-left: {{ section.settings.gap }}px;
    /* A animação translada 50% da largura total (que é duplicada no HTML) */
    animation: scrollMarquee {{ section.settings.speed }}s linear infinite;
  }

  /* Pausa a animação sutilmente quando o mouse passa por cima (UX de Luxo) */
  .brand-marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes scrollMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - ({{ section.settings.gap }}px / 2)));
    }
  }

  .brand-marquee__item {
    flex: 0 0 auto;
    width: {{ section.settings.logo_width }}px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease;
  }

  .brand-marquee__item:hover {
    opacity: 0.6; /* Efeito hover mais elegante que o scale para logos */
  }

  .brand-marquee__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .brand-marquee__image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .brand-marquee__placeholder {
    width: 100%;
    height: 60px;
    background-color: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media (max-width: 768px) {
    .brand-marquee__item {
      width: {{ section.settings.mobile_logo_width }}px;
    }
    .brand-marquee-section {
        padding-top: {{ section.settings.padding_top | times: 0.75 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 }}px;
    }
  }
</style>

<div class="brand-marquee-section">
  <div class="brand-marquee-track">
    {% for block in section.blocks %}
      <div class="brand-marquee__item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="brand-marquee__link">
        {% endif %}

        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 400 | image_tag: class: 'brand-marquee__image', loading: 'lazy' }}
        {% else %}
          <div class="brand-marquee__placeholder">Brand</div>
        {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}

    {% for block in section.blocks %}
      <div class="brand-marquee__item" aria-hidden="true">
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="brand-marquee__link" tabindex="-1">
        {% endif %}

        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 400 | image_tag: class: 'brand-marquee__image', loading: 'lazy' }}
        {% else %}
          <div class="brand-marquee__placeholder">Brand</div>
        {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
